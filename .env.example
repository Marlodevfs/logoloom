# LogoLoom Environment Variables
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Paddle (Pro subscription). Sandbox values start with test_ / contain sdbx.
# Public (browser):
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEARLY=
# Secret (server only):
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Optional: sandbox | production (guessed from the API key otherwise)
PADDLE_ENVIRONMENT=
# Secret used to sign Pro tokens (generate with: openssl rand -base64 32)
PRO_SIGNING_SECRET=

# Analytics: GoatCounter is loaded directly in app/[locale]/layout.tsx (no env var needed)
