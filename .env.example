# LogoLoom Environment Variables
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (Optional Pro White-Label subscription)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_WEBHOOK_SECRET=
# Secret used to sign Pro tokens (REQUIRED in production if STRIPE_SECRET_KEY is not set).
# Generate one with: openssl rand -base64 32
PRO_SIGNING_SECRET=

# Analytics: GoatCounter is loaded directly in app/[locale]/layout.tsx (no env var needed)
